# ══════════════════════════════════════════════════════════════
# 三省六部 · Git Ignore
# ══════════════════════════════════════════════════════════════

# ── 运行时数据 ──
data/

# ── 构建产物 ──
dashboard/dist/

# ── 依赖 ──
node_modules/
.venv/
venv/

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── 系统文件 ──
.DS_Store
Thumbs.db

# ── 日志 ──
*.log
/tmp/

# ── 备份 ──
*.bak*
